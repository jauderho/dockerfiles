FROM ghcr.io/jauderho/alpine:3.24.1@sha256:10b76ac1c893c93b8db0c741d0439cf2eee48cff9de40879ed735178e2fc1547 AS build

ARG BUILD_VERSION
#ARG ARCHIVE_URL=https://github.com/yt-dlp/yt-dlp/archive/
ARG RELEASE_URL=https://github.com/yt-dlp/yt-dlp-nightly-builds/releases/download/

ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
	UV_NO_CACHE=1 \
	UV_LINK_MODE=copy \
	UV_PYTHON_DOWNLOADS=never

COPY pyproject.toml uv.lock ./

RUN set -x \
 && apk update \
 && apk upgrade -a \
 && apk add --no-cache \
        ca-certificates \
        curl \
        python3 \
        uv \
        build-base \
        gcc \
        make \
        python3-dev \
        zstd-dev \
        nghttp2-dev \
        libffi-dev \
 # --no-install-project: this project only declares dependencies, there is no
 # package here to build. --frozen installs uv.lock exactly as written. Only
 # the stable deps (mutagen, pycryptodomex) are locked here; curl_cffi is
 # resolved from the release below.
 && uv sync --frozen --no-install-project --no-dev --python /usr/bin/python3 \
 # yt-dlp itself is a self-contained zipapp, not a package from an index
 && cd /usr/local/bin \
 && curl -Lo yt-dlp --proto "=https" --proto-redir "=https" \
        "${RELEASE_URL}${BUILD_VERSION}/yt-dlp" \
 && curl -Lo SHA2-256SUMS --proto "=https" --proto-redir "=https" \
        "${RELEASE_URL}${BUILD_VERSION}/SHA2-256SUMS" \
 && cat SHA2-256SUMS | grep "yt-dlp$" | sha256sum -csw - \
    # 0555: read+execute for everyone, write bit set for no one. Nothing
    # in the image updates it in place. root can still override this via
    # CAP_DAC_OVERRIDE, so it hardens against a non-root --user only.
 && chmod 0555 /usr/local/bin/yt-dlp \
 # Install curl_cffi separately, constrained to the range this yt-dlp release
 # declares for its curl-cffi extra rather than a range pinned by hand in
 # pyproject.toml. Installing outside that range makes yt-dlp silently drop the
 # impersonate handler: https://github.com/jauderho/dockerfiles/issues/7774
 # The range is read out of the sdist, which is checksummed like the zipapp.
 && case "$(uname -m)" in \
       x86_64|aarch64) \
            curl -Lo yt-dlp.tar.gz --proto "=https" --proto-redir "=https" \
                 "${RELEASE_URL}${BUILD_VERSION}/yt-dlp.tar.gz" \
         && cat SHA2-256SUMS | grep "yt-dlp.tar.gz$" | sha256sum -csw - \
         && CURL_CFFI_REQ="$(/usr/bin/python3 -c 'import tarfile, tomllib; \
                t = tarfile.open("yt-dlp.tar.gz"); \
                n = [i for i in t.getnames() if i.count("/") == 1 \
                     and i.endswith("/pyproject.toml")][0]; \
                d = tomllib.load(t.extractfile(n)); \
                e = d["project"]["optional-dependencies"]["curl-cffi"]; \
                r = [x for x in e if x.lower().startswith("curl")][0]; \
                print(r.split(";")[0].strip())')" \
         && echo "yt-dlp ${BUILD_VERSION} requires ${CURL_CFFI_REQ}" \
         && uv pip install --python /opt/venv/bin/python "${CURL_CFFI_REQ}" \
         && rm yt-dlp.tar.gz ;; \
       *) echo "Skipping curl_cffi: unsupported arch $(uname -m)" ;; \
    esac \
 && rm SHA2-256SUMS \
 && find /opt/venv -name '__pycache__' -print0 | xargs -0 -n1 rm -rf


# ----------------------------------------------------------------------------


# Same digest as the build stage: the venv hardcodes lib/python3.X, so a
# different Python minor version here would silently break it.
FROM ghcr.io/jauderho/alpine:3.24.1@sha256:10b76ac1c893c93b8db0c741d0439cf2eee48cff9de40879ed735178e2fc1547

# https://github.com/Yelp/dumb-init/releases
ARG DUMB_INIT_VERSION=1.2.5

COPY --from=build /opt/venv /opt/venv
COPY --from=build /usr/local/bin/yt-dlp /usr/local/bin/yt-dlp

# The zipapp runs under "env python3", so the venv has to be ahead of
# /usr/bin on PATH for it to see curl_cffi, mutagen and pycryptodomex.
ENV PATH="/opt/venv/bin:${PATH}"

RUN set -x \
 && apk update \
 && apk upgrade -a \
 && apk add --no-cache \
        ca-certificates \
        dumb-init \
        ffmpeg \
        python3 \
        zstd \
        nghttp2 \
 && apk add --no-cache -X https://dl-cdn.alpinelinux.org/alpine/edge/community deno simdutf \
 # Create directory to hold downloads.
 && mkdir /downloads \
    # 0750, not world-writable: root is the only account that writes
    # here. Running with --user needs a bind mount over /downloads to
    # keep anything, and then the host directory's permissions apply
    # instead of these - so nothing that survives a run needs o+w.
 && chmod 0750 /downloads \
 # Sets up cache.
 && mkdir /.cache \
    # Only consulted when HOME resolves to /, i.e. under --user. Left
    # root-owned: a missed cache is not fatal, yt-dlp just recomputes.
 && chmod 0750 /.cache \
 && rm -rf /var/cache/apk/*

ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

WORKDIR /downloads

VOLUME ["/downloads"]

# Basic check.
RUN dumb-init yt-dlp --version \
 && python3 -c 'import mutagen, Cryptodome, curl_cffi; print("deps OK")' \
 # Fail loudly if the installed curl_cffi is not usable for impersonation.
 && case "$(uname -m)" in \
       x86_64|aarch64) \
            dumb-init yt-dlp --list-impersonate-targets > /tmp/impersonate-targets \
         && cat /tmp/impersonate-targets \
         && grep curl_cffi /tmp/impersonate-targets | grep -qv "(unavailable)" \
         && rm /tmp/impersonate-targets ;; \
       *) echo "Skipping impersonate check: unsupported arch $(uname -m)" ;; \
    esac \
 && find /opt/venv -name '__pycache__' -print0 | xargs -0 -n1 rm -rf \
 && find /usr/lib/ -name '__pycache__' -print0 | xargs -0 -n1 rm -rf \
 && find /usr/lib/ -name '*.pyc' -print0 | xargs -0 -n1 rm -rf

ENTRYPOINT ["dumb-init", "yt-dlp"]
CMD ["--help"]
