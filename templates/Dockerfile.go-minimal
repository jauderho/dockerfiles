#
# See https://medium.com/@chemidy/create-the-smallest-and-secured-golang-docker-image-based-on-scratch-4752223b7324
#
FROM ghcr.io/jauderho/golang:1.27.2-alpine3.24@sha256:0b3d9da361d98efa0c0dcfc678942f4f0e956c1a1addfbf6fbc52286ca6558d6 as build-env

WORKDIR /go/src/app
ADD . /go/src/app

RUN go get -d -v ./...

RUN go build -o /go/bin/app

FROM gcr.io/distroless/base-debian13@sha256:389cad21f73e4c37b94ffe5b13736d5a92bd5bd3c6c6b38c2be1c881e14ba2bd
COPY --from=build-env /go/bin/app /
CMD ["/app"]
