#
# See https://medium.com/@chemidy/create-the-smallest-and-secured-golang-docker-image-based-on-scratch-4752223b7324
#
FROM ghcr.io/jauderho/golang:1.27.4-alpine3.24@sha256:1ae3362f542ecfd43085d9fbb264d3ab4c0cb91e6ee70bea3d45194d4139b76c as build-env

WORKDIR /go/src/app
ADD . /go/src/app

RUN go get -d -v ./...

RUN go build -o /go/bin/app

FROM gcr.io/distroless/base-debian13@sha256:0e48b9bcd868bce9fa872cee10b52961d9e32677823da4bf68eefb44f38e7b9d
COPY --from=build-env /go/bin/app /
CMD ["/app"]
